# Base URLs the browser talks to (baked into the client bundle at build time).
# Local dev defaults match `docker compose up` / a server on :4000.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000

# For a split deployment (web on Vercel, API on Railway/any long-running host):
# NEXT_PUBLIC_API_URL=https://<your-api-host>/api
# NEXT_PUBLIC_WS_URL=https://<your-api-host>
