# Host ports for `docker compose up` — override to avoid clashes.
LB_MONGO_PORT=27017
LB_REDIS_PORT=6379
LB_API_PORT=4000
LB_WEB_PORT=3000

# JWT secret for the compose server service (change it).
LB_JWT_SECRET=change-me-in-production

# Origin allowed by CORS on the compose server service.
LB_WEB_ORIGIN=http://localhost:3000
